# copy to .env and fill in. .env is git-ignored.

# required - app refuses to boot without it
JWT_SECRET=replace-with-a-long-random-string

ACCESS_TOKEN_MINUTES=30
DATABASE_URL=sqlite:///./terrapulse.db

# comma separated, exact origins, no wildcard
CORS_ORIGINS=http://localhost:5173

DATA_DIR=../data
PIPELINE_MODE=mock
DEBUG=true

# seeded demo accounts, created on first boot if absent
SEED_VIEWER_PASSWORD=viewer
SEED_ANALYST_PASSWORD=analyst
SEED_AUTHORITY_PASSWORD=officer

# only used when PROVIDER=sentinel
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

MOCK_STAGE_SECONDS=0.55
RATE_LIMIT_ENABLED=true
